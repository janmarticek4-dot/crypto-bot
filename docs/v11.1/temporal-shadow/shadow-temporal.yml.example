# Install ONLY in a separate research repository as .github/workflows/shadow-temporal.yml.
# Immutable tested review source; update both pins only between observation days.
name: Automated Research Shadow
on:
  schedule:
    # Both UTC offsets, with delayed-run retries; real Bratislava clock gates collection.
    - cron: '0,15,30 5-7,18-20 * * *'
  workflow_dispatch:
permissions:
  contents: read
  actions: read
concurrency:
  group: research-temporal-observations
  cancel-in-progress: false
jobs:
  shadow:
    uses: janmarticek4-dot/crypto-bot/.github/workflows/v11-temporal-shadow.yml@dedf8427ac83fbfea5daef14078ba95fe2015950
    with:
      source_sha: dedf8427ac83fbfea5daef14078ba95fe2015950
      observation_workflow: shadow-temporal.yml
