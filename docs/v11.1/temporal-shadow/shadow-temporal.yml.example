# Install ONLY in a separate research repository as .github/workflows/shadow-temporal.yml.
# Replace PIN_REVIEW_COMMIT with the same 40-character review-branch SHA in both places.
name: Automated Research Shadow
on:
  schedule:
    # Both UTC offsets, with delayed-run retries; real Bratislava clock gates collection.
    - cron: '0,15,30 5-7,18-20 * * *'
  workflow_dispatch:
permissions:
  contents: read
  actions: read
concurrency:
  group: research-temporal-observations
  cancel-in-progress: false
jobs:
  shadow:
    uses: janmarticek4-dot/crypto-bot/.github/workflows/v11-temporal-shadow.yml@PIN_REVIEW_COMMIT
    with:
      source_sha: PIN_REVIEW_COMMIT
